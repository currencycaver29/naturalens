{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naturalens-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "naturalens.ca", "custom_domain": true },
    { "pattern": "www.naturalens.ca", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "AUTH_FROM": "NaturaLens <hello@naturalens.ca>"
  },
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "naturalens-waitlist",
      "database_id": "de698223-6c18-4989-8cb7-8a46ac615915",
      "migrations_dir": "migrations"
    }
  ]
}
