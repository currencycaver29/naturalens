# Copy this file to .env and paste your key in. .env is gitignored.
#
# EXPO_PUBLIC_* vars are inlined into the app bundle, so treat them as public.
#
# Gemini API key — get a free one at https://aistudio.google.com/apikey (no credit card needed).
# Restrict it in AI Studio rather than relying on it staying secret.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional. Defaults to https://naturalens.ca (the live Worker).
# For local auth against `wrangler dev` / `npm run preview` in apps/web:
#   iOS simulator:     http://localhost:8787
#   Android emulator:  http://10.0.2.2:8787
#   Physical device:   http://<your-lan-ip>:8787
# EXPO_PUBLIC_API_BASE_URL=https://naturalens.ca
